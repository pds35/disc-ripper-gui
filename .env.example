# Copy this to .env and fill in real values. .env is gitignored — never
# commit real values, even though nothing here is sensitive yet.

# Device path for the optical drive
DRIVE_DEVICE=/dev/sr0

# Where ripped media lands (must be owned by pauls:pauls — see brief)
MEDIA_MOVIES_DIR=/mnt/nvme/media/movies
MEDIA_MUSIC_DIR=/mnt/nvme/media/music

# Port the Flask app listens on
APP_PORT=5000
