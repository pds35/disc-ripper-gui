# Python
__pycache__/
*.pyc
.pytest_cache/
venv/
.venv/

# Env / secrets — real values never get committed, .env.example does
.env

# OS cruft
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/

# Ripped media should never end up in the repo by accident
*.mkv
*.flac
*.ogg

# SQLite job history — generated at runtime, grows with real usage,
# shouldn't be committed (same reasoning as ripped media above)
data/*.db

